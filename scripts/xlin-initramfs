#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Axion Co.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Xlin Initramfs: build the minimal initramfs used by the Xlin Kernel boot test.
#
# The archive contains only: /init (tests/boot/init), /bin/xlin-pass, one static BusyBox
# binary with its applet symlinks, and the empty mount points. It is independent of XlinOS.
# With --runtime it instead carries the runtime-validation guest (tests/runtime: /init, the
# helper library, the suites and the probe table) and, with --kmod, the kmod tools of the build
# machine (a runner-installed package: its binaries are copied into the archive at build time and
# are never committed).
# It is written with the kernel's own gen_init_cpio tool, compiled from the PINNED source
# (usr/gen_init_cpio.c), so no root privileges and no cpio program are needed, and device
# nodes can be included. The archive is a build artifact and is never committed.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/xlin-lock.sh
. "$ROOT/scripts/lib/xlin-lock.sh"

usage() {
	cat <<'USAGE'
Usage: scripts/xlin-initramfs [options]

Options:
  --busybox PATH    static BusyBox binary (default: busybox from PATH;
                    Debian/Ubuntu: package busybox-static)
  --init FILE       the /init script (default: tests/boot/init)
  --src DIR         pinned kernel source, for usr/gen_init_cpio.c
                    (default: upstream/src/linux)
  --runtime         build the runtime-validation initramfs (tests/runtime) instead
  --kmod PATH       also include this kmod binary and the shared libraries it needs
                    (modprobe, insmod, rmmod, lsmod, depmod and modinfo become links to it)
  --out FILE        output archive (default: build/boot-test/initramfs.cpio.zst)
  --compress TYPE   zstd (default), gzip or xz
  -h, --help        show this help

Writes FILE and FILE.manifest (contents, sizes and SHA-256 of every input).
Exit status: 0 = written; 1 = failed; 3 = a needed tool or input is missing.
USAGE
}

busybox=""
init="$ROOT/tests/boot/init"
src="$ROOT/upstream/src/linux"
out="$ROOT/build/boot-test/initramfs.cpio.zst"
comp=zstd
runtime=0
kmod=""
while [ $# -gt 0 ]; do
	case $1 in
	--busybox) [ $# -ge 2 ] || xlin_die "--busybox needs a value"; busybox=$2; shift 2 ;;
	--init) [ $# -ge 2 ] || xlin_die "--init needs a value"; init=$2; shift 2 ;;
	--src) [ $# -ge 2 ] || xlin_die "--src needs a value"; src=$2; shift 2 ;;
	--runtime) runtime=1; shift ;;
	--kmod) [ $# -ge 2 ] || xlin_die "--kmod needs a value"; kmod=$2; shift 2 ;;
	--out) [ $# -ge 2 ] || xlin_die "--out needs a value"; out=$2; shift 2 ;;
	--compress) [ $# -ge 2 ] || xlin_die "--compress needs a value"; comp=$2; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) usage >&2; xlin_die "unknown option: $1" ;;
	esac
done
cant() { printf 'error: %s\n' "$*" >&2; exit 3; }
case $comp in zstd | gzip | xz) ;; *) xlin_die "--compress must be zstd, gzip or xz" ;; esac

[ -n "$busybox" ] || busybox=$(command -v busybox 2>/dev/null || true)
if [ -z "$busybox" ] || [ ! -x "$busybox" ]; then cant "no BusyBox found (install busybox-static, or use --busybox)"; fi
busybox=$(readlink -f "$busybox")
for t in gcc "$comp" sha256sum file; do
	command -v "$t" >/dev/null 2>&1 || cant "missing tool: $t"
done
if [ "$runtime" = 1 ]; then
	init="$ROOT/tests/runtime/init"
	[ -f "$init" ] || cant "init script not found: $init"
	for f in lib.sh probes.sh probes.tsv dmesg-allowlist.txt known-findings.txt udhcpc.script reboot-cycle; do
		[ -f "$ROOT/tests/runtime/$f" ] || cant "tests/runtime/$f is missing"
	done
fi
if [ -n "$kmod" ]; then
	[ -x "$kmod" ] || cant "kmod binary not found: $kmod"
	kmod=$(readlink -f "$kmod")
	command -v ldd >/dev/null 2>&1 || cant "missing tool: ldd"
fi
[ -f "$init" ] || cant "init script not found: $init"
[ -f "$src/usr/gen_init_cpio.c" ] || cant "no kernel source at $src (run scripts/xlin-fetch first)"
[ -f "$ROOT/tests/boot/xlin-pass" ] || cant "tests/boot/xlin-pass is missing"
file -L "$busybox" | grep -q 'statically linked' || cant "$busybox is not statically linked (a dynamic BusyBox cannot run in an initramfs without libraries)"

need="sh mount cat grep sed cut uname poweroff setsid cttyhack sync echo mkdir sleep"
if [ "$runtime" = 1 ]; then
	need="$need umount tr wc ls head tail dd od sha256sum zcat readlink basename dirname dmesg kill reboot rm awk tee sort"
fi
applets=$("$busybox" --list 2>/dev/null) || cant "$busybox does not support --list"
missing=""
for a in $need; do
	grep -qx "$a" <<<"$applets" || missing="$missing $a"
done
[ -z "$missing" ] || cant "BusyBox lacks the applet(s):$missing"
if [ "$runtime" = 1 ]; then
	# not required: the suites that use them report a clear failure or skip when one is absent
	for a in mountpoint ifconfig route udhcpc ping unshare; do
		grep -qx "$a" <<<"$applets" || echo "warning: BusyBox lacks the optional applet '$a'; dependent checks will be skipped or fail visibly" >&2
	done
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
gcc -O1 -o "$tmp/gen_init_cpio" "$src/usr/gen_init_cpio.c" || xlin_die "could not compile gen_init_cpio from the pinned source"

{
	echo "# generated by scripts/xlin-initramfs"
	for d in /bin /dev /proc /sys /tmp /run /etc /root; do echo "dir $d 0755 0 0"; done
	if [ "$runtime" = 1 ]; then for d in /mnt /lib /lib/modules /tests /tests/suites /sbin /usr /usr/bin /usr/sbin; do echo "dir $d 0755 0 0"; done; fi
	echo "nod /dev/console 0600 0 0 c 5 1"
	echo "nod /dev/null 0666 0 0 c 1 3"
	echo "file /bin/busybox $busybox 0755 0 0"
	while IFS= read -r a; do
		[ "$a" = busybox ] && continue
		if [ -n "$kmod" ]; then case $a in modprobe | insmod | rmmod | lsmod | depmod | modinfo) continue ;; esac; fi
		echo "slink /bin/$a busybox 0777 0 0"
	done <<<"$applets"
	echo "file /init $init 0755 0 0"
	echo "file /bin/xlin-pass $ROOT/tests/boot/xlin-pass 0755 0 0"
	if [ "$runtime" = 1 ]; then
		for f in lib.sh probes.sh probes.tsv dmesg-allowlist.txt known-findings.txt; do echo "file /tests/$f $ROOT/tests/runtime/$f 0644 0 0"; done
		for f in udhcpc.script reboot-cycle; do echo "file /tests/$f $ROOT/tests/runtime/$f 0755 0 0"; done
		for f in "$ROOT"/tests/runtime/suites/*.sh; do echo "file /tests/suites/${f##*/} $f 0644 0 0"; done
	fi
	if [ -n "$kmod" ]; then
		echo "file /bin/kmod $kmod 0755 0 0"
		for a in modprobe insmod rmmod lsmod depmod modinfo; do echo "slink /bin/$a kmod 0777 0 0"; done
		# shared libraries (as the dynamic loader finds them) and the loader itself
		ldd "$kmod" | while read -r line; do
			p=$(sed -n 's|.*=> \(/[^ ]*\) .*|\1|p; t; s|^[[:space:]]*\(/[^ ]*\) (.*|\1|p' <<<"$line")
			[ -n "$p" ] || continue
			echo "LIB $p"
		done >"$tmp/libs"
		while read -r _ p; do
			d=$(dirname "$p")
			while [ "$d" != / ]; do echo "$d"; d=$(dirname "$d"); done
		done <"$tmp/libs" | sort -u >"$tmp/libdirs"
		while read -r d; do case $d in /bin | /lib | /usr | /usr/bin | /usr/sbin | /sbin | /tmp | /run | /etc | /root | /dev | /proc | /sys | /mnt | /tests) ;; *) echo "dir $d 0755 0 0" ;; esac; done <"$tmp/libdirs"
		while read -r _ p; do echo "file $p $(readlink -f "$p") 0755 0 0"; done <"$tmp/libs"
	fi
} >"$tmp/list"

mkdir -p "$(dirname "$out")"
case $comp in
zstd) cc=(zstd -q -19 -T0 -c) ;;
gzip) cc=(gzip -9 -n -c) ;;
xz) cc=(xz --check=crc32 -9 -c) ;;
esac
# -t 0: every entry gets the same modification time, so the archive does not depend on the build time
"$tmp/gen_init_cpio" -t 0 "$tmp/list" | "${cc[@]}" >"$out"
[ -s "$out" ] || xlin_die "the archive is empty"

{
	echo "Xlin boot-test initramfs"
	echo "compression: $comp"
	echo "archive: $(stat -c %s "$out") bytes, sha256 $(sha256sum "$out" | cut -d' ' -f1)"
	echo "busybox: $("$busybox" 2>&1 | head -n1) ($busybox)"
	echo "busybox sha256: $(sha256sum "$busybox" | cut -d' ' -f1)"
	echo "applets: $(wc -l <<<"$applets")"
	echo "init: $init sha256 $(sha256sum "$init" | cut -d' ' -f1)"
	echo "runtime guest: $runtime"
	if [ -n "$kmod" ]; then
		echo "kmod: $("$kmod" --version 2>&1 | head -n1) ($kmod), sha256 $(sha256sum "$kmod" | cut -d' ' -f1)"
		echo "kmod package: $(dpkg-query -W -f '${Package} ${Version}' kmod 2>/dev/null || echo unknown); libkmod: $(dpkg-query -W -f '${Package} ${Version}' libkmod2 2>/dev/null || echo unknown)"
		echo "kmod libraries: $(sed 's/^LIB //' "$tmp/libs" | tr '\n' ' ')"
	fi
	echo "gen_init_cpio from: $(git -C "$src" rev-parse -q --verify HEAD 2>/dev/null || echo unknown)"
} >"$out.manifest"
echo "Wrote $out ($(stat -c %s "$out") bytes, $comp)"
echo "Manifest: $out.manifest"
