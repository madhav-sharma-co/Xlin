#
# /init of the Xlin Kernel runtime-validation initramfs. Independent of XlinOS: userspace is
# only BusyBox (and, for the module suite, kmod). It runs the suites named by the kernel
# command line (xlin.suites=a,b,c), prints one result line per check on the serial console
# and powers the VM off. The host runner (scripts/xlin-runtime-test) judges the output.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t securityfs securityfs /sys/kernel/security 2>/dev/null
mkdir -p /mnt /mnt/probe

. /tests/lib.sh
SUITE=init

# reboot-cycle scenario: a counter on a scratch disk survives warm reboots
if [ -x /tests/reboot-cycle ]; then /tests/reboot-cycle; fi

SUITES=$(cmdline_get xlin.suites | tr ',' ' ')
echo "XLIN-RUNTIME: BEGIN pid=$$ uptime=$(cut -d' ' -f1 /proc/uptime) release=$(uname -r) suites=$SUITES"
metric init_uptime "$(cut -d' ' -f1 /proc/uptime)" s
for s in $SUITES; do
	echo "XLIN-SUITE: $s BEGIN"
	if [ -f "/tests/suites/$s.sh" ]; then
		sh "/tests/suites/$s.sh"
		rc=$?
		[ "$rc" -eq 0 ] || echo "XLIN-TEST: $s suite-exit FAIL the suite script exited with status $rc"
	else
		echo "XLIN-TEST: $s suite-exists FAIL no such suite"
	fi
	echo "XLIN-SUITE: $s END"
done
echo "XLIN-RUNTIME: DONE"
sync
poweroff -f
sleep 10
