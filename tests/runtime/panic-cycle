# Deliberate kernel panic and recovery. A scratch virtio-blk disk carries a one-shot marker.
[ -n "$(sed -n 's/.*[ ]xlin\.panic=\(1\).*/\1/p' /proc/cmdline)" ] || exit 0
dev=""
i=0
while [ "$i" -lt 15 ] && [ -z "$dev" ]; do
	for b in /sys/block/vd*; do [ -b "/dev/${b##*/}" ] && dev=/dev/${b##*/}; done
	[ -n "$dev" ] || { sleep 1; i=$((i + 1)); }
done
[ -n "$dev" ] || { echo "XLIN-TEST: panic disk-appears FAIL no scratch disk"; exit 0; }
read_marker() { dd if="$dev" bs=512 count=1 2>/dev/null | tr -dc 'A-Z' | head -c 8; }
cur=$(read_marker)
if [ "$cur" != PANICKED ]; then
	echo "XLIN-PANIC: boot 1 of 2 uptime=$(cut -d' ' -f1 /proc/uptime): crashing the kernel on purpose (sysrq-c)"
	printf PANICKED | dd of="$dev" bs=512 count=1 conv=sync 2>/dev/null || {
		echo "XLIN-TEST: panic-marker-write FAIL could not write scratch marker"; exit 0;
	}
	sync
	[ "$(read_marker)" = PANICKED ] || { echo "XLIN-TEST: panic-marker-verify FAIL scratch marker did not persist"; exit 0; }
	echo 1 >/proc/sys/kernel/sysrq || { echo "XLIN-TEST: panic-sysrq-enable FAIL could not enable SysRq"; exit 0; }
	echo c >/proc/sysrq-trigger
	sleep 30
	echo "XLIN-TEST: panic-crash-triggered FAIL the kernel did not panic within 30 s of sysrq-c"
	exit 0
fi
printf 0 | dd of="$dev" bs=512 count=1 conv=sync 2>/dev/null || {
	echo "XLIN-TEST: panic-marker-clear FAIL could not clear scratch marker"; exit 0;
}
sync
[ -z "$(read_marker)" ] || { echo "XLIN-TEST: panic-marker-clear-verify FAIL scratch marker remains set"; exit 0; }
echo "XLIN-PANIC: boot 2 of 2 uptime=$(cut -d' ' -f1 /proc/uptime): recovered after the panic"
echo "XLIN-TEST: panic recovered PASS the VM rebooted by itself after the panic, marker was cleared, and a new boot reached user space"
