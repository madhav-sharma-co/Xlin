# Warm-reboot cycles. A counter in sector 0 of a scratch disk (xlin.reboot=N on the command
# line, the disk is the only virtio-blk device) survives each reboot. Below N it increments and
# reboots; at N it returns and the normal suites run. The host sees N+1 kernel boots.
n=$(sed -n 's/.*[ ]xlin\.reboot=\([0-9]*\).*/\1/p' /proc/cmdline)
[ -n "$n" ] || exit 0
dev=""
i=0
while [ "$i" -lt 15 ] && [ -z "$dev" ]; do
	for b in /sys/block/vd*; do [ -b "/dev/${b##*/}" ] && dev=/dev/${b##*/}; done
	[ -n "$dev" ] || { sleep 1; i=$((i + 1)); }
done
[ -n "$dev" ] || { echo "XLIN-TEST: reboot disk-appears FAIL no scratch disk"; exit 0; }
cur=$(dd if="$dev" bs=512 count=1 2>/dev/null | tr -dc '0-9' | head -c 4)
[ -n "$cur" ] || cur=0
echo "XLIN-REBOOT: boot $((cur + 1)) of $((n + 1)) uptime=$(cut -d' ' -f1 /proc/uptime)"
if [ "$cur" -lt "$n" ]; then
	printf '%s' "$((cur + 1))" | dd of="$dev" bs=512 count=1 conv=sync 2>/dev/null
	sync
	reboot -f
	sleep 30
fi
printf '%s' 0 | dd of="$dev" bs=512 count=1 conv=sync 2>/dev/null
echo "XLIN-TEST: reboot cycles PASS $((n + 1)) boots completed on one VM, counter on $dev"
