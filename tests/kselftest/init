#!/bin/busybox sh
/bin/busybox mount -t proc proc /proc; /bin/busybox mount -t sysfs sys /sys; /bin/busybox mount -t devtmpfs dev /dev 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /tmp
echo "XLIN-KSELFTEST: kernel $(uname -r) cpus=$(grep -c ^processor /proc/cpuinfo)"
# one line per program in kselftest-list.txt ("target:program"); exit 0 = pass, 4 = skip (KSFT_SKIP), anything else = fail
limit=${XLIN_KSELFTEST_LIMIT:-240}
for t in $(ls /payload/kselftest); do
	d=/payload/kselftest/$t
	[ -f "$d/list" ] || continue
	while read -r prog; do
		[ -n "$prog" ] || continue
		cd "$d" || continue
		timeout "$limit" "./$prog" >/tmp/out 2>&1
		rc=$?
		case $rc in 0) r=PASS ;; 4) r=SKIP ;; 124 | 137) r=TIMEOUT ;; *) r=FAIL ;; esac
		echo "XLIN-KSELFTEST: $t/$prog $r rc=$rc"
		if [ "$r" != PASS ]; then tail -n 6 /tmp/out | sed 's/^/XLIN-KSELFTEST-LOG: /'; fi
	done <"$d/list"
done
echo "XLIN-KSELFTEST: done"
poweroff -f
