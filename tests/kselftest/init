#!/bin/busybox sh
/bin/busybox mount -t proc proc /proc; /bin/busybox mount -t sysfs sys /sys; /bin/busybox mount -t devtmpfs dev /dev 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /tmp; mkdir -p /dev/shm; /bin/busybox mount -t tmpfs tmpfs /dev/shm
# dynamically linked programs: the loader and libraries were copied under /payload/lib
ln -s /payload/lib/lib64 /lib64 2>/dev/null
export LD_LIBRARY_PATH=/payload/lib/flat
echo "XLIN-KSELFTEST: kernel $(uname -r) cpus=$(grep -c ^processor /proc/cpuinfo)"
# one line per program in kselftest-list.txt ("target:program"); exit 0 = pass, 4 = skip (KSFT_SKIP), anything else = fail
limit=${XLIN_KSELFTEST_LIMIT:-240}
for t in $(ls /payload/kselftest); do
	d=/payload/kselftest/$t
	[ -f "$d/list" ] || continue
	while read -r prog; do
		[ -n "$prog" ] || continue
		cd "$d" || continue
		# what tools/testing/selftests/rseq/run_*.sh set: glibc must not register rseq itself
		case $t in rseq) export GLIBC_TUNABLES=glibc.pthread.rseq=0 ;; *) unset GLIBC_TUNABLES ;; esac
		timeout "$limit" "./$prog" >/tmp/out 2>&1
		rc=$?
		case $rc in 0) r=PASS ;; 4) r=SKIP ;; 124 | 137) r=TIMEOUT ;; *) r=FAIL ;; esac
		echo "XLIN-KSELFTEST: $t/$prog $r rc=$rc"
		if [ "$r" != PASS ]; then grep -E 'FAIL|not ok|rror|Could not|cannot|Totals|device not found' /tmp/out | tail -n 12 | sed 's/^/XLIN-KSELFTEST-LOG: /'; fi
	done <"$d/list"
done
echo "XLIN-KSELFTEST: done"
poweroff -f
